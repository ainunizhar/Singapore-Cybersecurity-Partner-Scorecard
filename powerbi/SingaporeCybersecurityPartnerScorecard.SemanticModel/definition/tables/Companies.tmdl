	column 'Has Disclosed Funding'
		dataType: string
		lineageTag: 9f245091-71c5-5347-b728-624487b9719a
		summarizeBy: none
		sourceColumn: Has Disclosed Funding

	partition Companies = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sg_companies.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Geographic Reach Order", "Size Tier Order", "Partnership Score", "Coverage Score", "Gap Priority Order", "Founded Year", "Total Funding USD", "Latest Round Amount USD", "Decision Makers Found"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Company", type text}, {"Website", type text}, {"City", type text}, {"Description", type text}, {"Primary Segment", type text}, {"Segment", type text}, {"Sub-Segment", type text}, {"Market Focus", type text}, {"Geographic Reach", type text}, {"Geographic Reach Order", Int64.Type}, {"Size Tier", type text}, {"Size Tier Order", Int64.Type}, {"Partnership Score", Int64.Type}, {"Score Tier", type text}, {"Score Rationale", type text}, {"Segmentation Confidence", type text}, {"Regulatory Flag", type text}, {"CSA Licensed", type text}, {"CSA Detail", type text}, {"CREST Certified", type text}, {"CREST Detail", type text}, {"Operating Status", type text}, {"Growth Score Tier", type text}, {"Heat Score Tier", type text}, {"Services Listed", type text}, {"Research Sources", type text}, {"S1 SIEM", type text}, {"S2 MDR/EDR", type text}, {"S3 SOC", type text}, {"S4 Vulnerability Mgmt", type text}, {"S5 Incident Response", type text}, {"S6 Cloud Security", type text}, {"S7 IAM", type text}, {"S8 Compliance/GRC", type text}, {"S9 OT/ICS", type text}, {"Coverage Score", Int64.Type}, {"Gap Priority", type text}, {"Gap Priority Order", Int64.Type}, {"Upsell Services", type text}, {"MAS/CSA Focus", type text}, {"Services Confidence", type text}, {"Services Page URL", type text}, {"SIEM Platform", type text}, {"SIEM Platform Detail", type text}, {"Other Vendors", type text}, {"Vendor Confidence", type text}, {"Vendor Deep-Verified", type text}, {"Ownership Type", type text}, {"Funding Stage", type text}, {"Founded Year", Int64.Type}, {"Total Funding USD", type number}, {"Latest Round", type text}, {"Latest Round Amount USD", type number}, {"Latest Round Date", type text}, {"Revenue Estimate", type text}, {"Growth Signal", type text}, {"Exit Likelihood", type text}, {"Government-Linked", type text}, {"Funding Confidence", type text}, {"GTM Model", type text}, {"GTM Confidence", type text}, {"GTM Evidence", type text}, {"GTM Evidence URL", type text}, {"SG Presence Confirmed", type text}, {"Screening Priority Flag", type text}, {"Decision Makers Found", Int64.Type}}, "en-US"),
				    ScoreLabel = Table.AddColumn(Typed, "Score Label", each Text.From([Partnership Score]) & " - " & [Score Tier], type text),
				    Funded = Table.AddColumn(ScoreLabel, "Has Disclosed Funding", each if [Total Funding USD] = null then "No" else "Yes", type text)
