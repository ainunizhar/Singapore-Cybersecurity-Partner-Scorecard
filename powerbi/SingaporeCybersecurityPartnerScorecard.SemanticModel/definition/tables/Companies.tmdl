table Companies
	lineageTag: fa3a00b5-0c6e-5a11-a8d1-f18704d1481c

	measure Partners = COUNTROWS ( Companies )
		formatString: #,0
		lineageTag: 2f9be14c-dc26-53e4-b6cf-07d07624057c

	measure 'Priority Partners (Score 4-5)' = CALCULATE ( [Partners], Companies[Partnership Score] >= 4 )
		formatString: #,0
		lineageTag: 145d4d6e-884f-521c-a475-6370c949b787

	measure 'Tier 1 Partners (Score 5)' = CALCULATE ( [Partners], Companies[Partnership Score] = 5 )
		formatString: #,0
		lineageTag: b3b5786e-c687-5f46-9fd7-f62cb6f260e9

	measure 'Avg Partnership Score' = AVERAGE ( Companies[Partnership Score] )
		formatString: 0.00
		lineageTag: f59d6520-7829-5d17-80d4-77c1d7c372f7

	measure 'Avg Coverage Score' = AVERAGE ( Companies[Coverage Score] )
		formatString: 0.0
		lineageTag: 10552493-8509-5620-8e5a-3766c46b7dc9

	measure 'High Gap Priority' = CALCULATE ( [Partners], Companies[Gap Priority] = "High" )
		formatString: #,0
		lineageTag: 5b7ee8fd-6e9e-5ab9-a8b3-532925df4183

	measure 'MAS/CSA Focus %' = DIVIDE ( CALCULATE ( [Partners], Companies[MAS/CSA Focus] = "Yes" ), [Partners] )
		formatString: 0%
		lineageTag: 9fab4c6c-05e4-5486-b525-ea0cb31f1e20

	measure 'CSA Licensed (Confirmed)' = CALCULATE ( [Partners], Companies[CSA Licensed] = "Yes" )
		formatString: #,0
		lineageTag: 5e9b4658-7fea-53f0-845b-5f457f3ef344

	measure 'CREST Certified (Confirmed)' = CALCULATE ( [Partners], Companies[CREST Certified] = "Yes" )
		formatString: #,0
		lineageTag: 3f695daa-6691-5aa2-9215-86c0b482ad6d

	measure 'Regulatory Flag Confirmed' = CALCULATE ( [Partners], Companies[Regulatory Flag] = "Confirmed" )
		formatString: #,0
		lineageTag: 1b42ecd1-72be-5304-bb1e-1114a86daf6e

	measure 'No Longer Independent' = CALCULATE ( [Partners], Companies[Operating Status] IN { "Acquired", "Dormant", "Closed" } )
		formatString: #,0
		lineageTag: b838a55a-a39e-5a64-b91f-f10706bf6799

	measure 'Partners With Disclosed Funding' = CALCULATE ( [Partners], Companies[Has Disclosed Funding] = "Yes" )
		formatString: #,0
		lineageTag: 92787830-d9e5-5415-9732-48545f2c2ab7

	measure 'Disclosed Funding ($M)' = DIVIDE ( SUM ( Companies[Total Funding USD] ), 1000000 )
		formatString: #,0.0
		lineageTag: d1d6771b-38e4-5da8-ac72-9870e35f5e68

	measure 'Government-Linked Partners' = CALCULATE ( [Partners], Companies[Government-Linked] = "Yes" )
		formatString: #,0
		lineageTag: f783cca2-f726-55bb-80f5-d79c91a48c39

	measure 'Partner-led or Hybrid GTM' = CALCULATE ( [Partners], Companies[GTM Model] IN { "Partner-led", "Hybrid" } )
		formatString: #,0
		lineageTag: 6766ef5a-89a7-5600-b4f0-5b71e5e1be61

	measure 'Decision Maker Identified %' = DIVIDE ( CALCULATE ( [Partners], Companies[Decision Makers Found] > 0 ), [Partners] )
		formatString: 0%
		lineageTag: 61c56324-77dd-50f6-84c6-84dfb51d48a1

	measure 'Vendor Rows Deep-Verified' = CALCULATE ( [Partners], Companies[Vendor Deep-Verified] = "Yes" )
		formatString: #,0
		lineageTag: 128238b1-8f3f-5257-9eb9-18e2555e0470

	measure 'Partner Name' = SELECTEDVALUE ( Companies[Company], "Several partners" )
		lineageTag: 38a8cb05-f08a-54a7-a41e-d5436c76c66a

	measure 'Credential Badges' = IF ( HASONEVALUE ( Companies[Company] ), VAR csa = SELECTEDVALUE ( Companies[CSA Licensed] ) = "Yes" VAR crest = SELECTEDVALUE ( Companies[CREST Certified] ) = "Yes" VAR mas = SELECTEDVALUE ( Companies[MAS/CSA Focus] ) = "Yes" RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='22' viewBox='0 0 200 22'>" & "<rect x='1' y='2' width='46' height='18' rx='9' fill='" & IF ( csa, "%23E3464B", "none" ) & "' stroke='" & IF ( csa, "%23E3464B", "%23A3AEC0" ) & "'/><text x='24' y='15' font-family='Segoe UI' font-size='11' font-weight='700' text-anchor='middle' fill='" & IF ( csa, "white", "%23A3AEC0" ) & "'>CSA</text>" & "<rect x='53' y='2' width='62' height='18' rx='9' fill='" & IF ( crest, "%23E3464B", "none" ) & "' stroke='" & IF ( crest, "%23E3464B", "%23A3AEC0" ) & "'/><text x='84' y='15' font-family='Segoe UI' font-size='11' font-weight='700' text-anchor='middle' fill='" & IF ( crest, "white", "%23A3AEC0" ) & "'>CREST</text>" & "<rect x='121' y='2' width='76' height='18' rx='9' fill='" & IF ( mas, "%23E3464B", "none" ) & "' stroke='" & IF ( mas, "%23E3464B", "%23A3AEC0" ) & "'/><text x='159' y='15' font-family='Segoe UI' font-size='11' font-weight='700' text-anchor='middle' fill='" & IF ( mas, "white", "%23A3AEC0" ) & "'>MAS/CSA</text>" & "</svg>" )
		dataCategory: ImageUrl
		lineageTag: 91487e6c-75ac-598a-a605-e1b6115b6b0f

	measure 'KPI Sub Partners' = FORMAT ( CALCULATE ( [Partners], LEFT ( Companies[Operating Status], 6 ) = "Active" ) + 0, "#,0" ) & " active   ·   " & FORMAT ( [No Longer Independent] + 0, "#,0" ) & " acquired or closed"
		lineageTag: 845aeaf9-1259-561d-b742-9ec991339e8a

	measure 'KPI Sub Priority' = FORMAT ( DIVIDE ( [Priority Partners (Score 4-5)], [Partners] ), "0%" ) & " of partners score 4–5"
		lineageTag: dcdb1d29-e147-5961-940d-f313da4c8ff4

	measure 'KPI Sub Tier1' = "score 5 of 5   ·   average score " & FORMAT ( [Avg Partnership Score], "0.0" )
		lineageTag: cd18382a-2551-5a4b-92fa-556bb226824c

	measure 'KPI Sub CSA' = FORMAT ( CALCULATE ( [Partners], Companies[CSA Licensed] = "Unverified" ) + 0, "#,0" ) & " not yet verified"
		lineageTag: 7adff08d-40d4-55a1-a0af-2bf6d92a321c

	measure 'KPI Sub CREST' = FORMAT ( CALCULATE ( [Partners], Companies[CREST Certified] = "Unverified" ) + 0, "#,0" ) & " not yet verified"
		lineageTag: e73088a1-0c93-5a12-82ea-b06aa66c0548

